# .gitignore for MiniAgent

# 敏感文件（绝不提交）
.env
.env.local
.env.production
*.key
*.pem
credentials.json

# 用户级配置（不同机器不同）
.miniagent/memory/
.miniagent/sessions/
.miniagent/history/
.miniagent/config.local.json
.miniagent/*.db
.miniagent/*.db-*
.miniagent/*.log
.miniagent/crash.log
.miniagent/update-cache.json
local_llm/configs/ollama.env

# 构建产物
dist/
web/dist/
*.tsbuildinfo

# 依赖
node_modules/

# 系统文件
.DS_Store
Thumbs.db

# 测评临时文件
evaluation/runners/__pycache__/
evaluation/results/_smoke_tests/

# Python 缓存
.pytest_cache/
__pycache__/
*.pyc

# 公众号文章
articles/

# 日志文件
*.log

# IDE
.vscode/
.idea/

# MiniAgent 测试演示输出（整体忽略）
demo-output/

# 旧版散乱文件（已迁移到 demo-output/）
admin-system/
admin-system-project/
wechat-post.md
screenshot_capture.py
screenshots/

# 散乱测试产物（已迁移到 demo-output/test-artifacts/）
test_*.txt
ollama-full-response.txt
dev_prompt.txt
call-ollama*.mjs
temp-call-ollama.mjs
extract-ollama-files.mjs
screenshots.mjs
