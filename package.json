{
  "name": "miniagent",
  "version": "0.2.0",
  "description": "A local AI Agent framework — runs on your machine with Ollama, no cloud needed.",
  "main": "dist/cli.js",
  "type": "module",
  "bin": {
    "miniagent": "./dist/cli.js"
  },
  "overrides": {
    "lru-cache": "^11.0.0"
  },
  "scripts": {
    "build": "bun run build:cli && bun run build:web",
    "build:cli": "bun build src/cli.ts --outdir dist --target node --format esm --external better-sqlite3 --external sqlite3 --external sqlite --external ollama --external terminal-kit --external express --external cors --external ws --external lru-cache --external chevrotain --external minimatch --external glob --external node-fetch --external diff --external zod --external chalk --external commander",
    "build:web": "vite build --config vite.web.config.ts",
    "chat": "bun run src/cli.ts chat",
    "dev": "bun run src/cli.ts chat",
    "serve": "bun run src/cli.ts serve",
    "check": "tsc --noEmit --project tsconfig.cli.json",
    "dev:web": "vite --config vite.web.config.ts",
    "prepublishOnly": "bun run build:cli"
  },
  "files": [
    "dist/",
    "web/dist/",
    "README.md"
  ],
  "keywords": [
    "agent",
    "ai",
    "cli",
    "ollama",
    "llm",
    "local-ai",
    "code-assistant",
    "terminal"
  ],
  "license": "MIT",
  "author": "Zevan",
  "homepage": "https://github.com/zevan/miniagent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zevan/miniagent.git"
  },
  "bugs": {
    "url": "https://github.com/zevan/miniagent/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "terminal-kit": "^3.1.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "ollama": "^0.5.0",
    "glob": "^10.4.0",
    "node-fetch": "^3.3.2",
    "diff": "^7.0.0",
    "zod": "^3.23.0",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "ws": "^8.18.0",
    "minimatch": "^9.0.0",
    "chevrotain": "^11.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/diff": "^7.0.0",
    "@types/express": "^4.17.0",
    "@types/cors": "^2.8.0",
    "@types/ws": "^8.5.0",
    "@types/node": "^20.11.5",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
