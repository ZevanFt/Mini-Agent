# Ollama 环境配置模板
# 复制此文件为 ollama.env，并根据你的机器配置修改
#
# 加载方式（PowerShell）：
#   Get-Content local_llm/configs/ollama.env | ForEach-Object {
#     $key, $value = $_ -split '=', 2
#     [Environment]::SetEnvironmentVariable($key, $value, 'User')
#   }

# 模型存储路径（修改为你的 Ollama 模型目录）
OLLAMA_MODELS=C:\Users\YourUsername\.ollama\models

# Ollama 服务地址（默认即可）
OLLAMA_HOST=127.0.0.1:11434

# Ollama 可执行文件路径（修改为你的 ollama.exe 位置）
OLLAMA_BIN=C:\Users\YourUsername\AppData\Local\Ollama\ollama.exe
